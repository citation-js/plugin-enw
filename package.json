{
  "name": "@citation-js/plugin-enw",
  "version": "0.3.0",
  "description": "Citation.js plugin for .enw files",
  "main": "lib/index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "mocha -r @babel/register test/suite.js",
    "babel": "babel src -d lib --copy-files",
    "lint": "standard \"src/**/*.js\" \"test/**/*.js\"",
    "changelog": "conventional-changelog -p angular && git add CHANGELOG.md",
    "coverage": "NODE_ENV=coverage nyc npm test",
    "report": "nyc report --reporter=lcov > coverage.lcov",
    "preversion": "npm run lint && npm run test",
    "version": "npm run changelog",
    "postversion": "npm run babel"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citation-js/plugin-enw.git"
  },
  "keywords": [
    "EndNote"
  ],
  "author": "Lars Willighagen (https://larsgw.github.io/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/citation-js/plugin-enw/issues"
  },
  "homepage": "https://github.com/citation-js/plugin-enw#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "/lib",
    "/index.d.ts"
  ],
  "standard": {
    "parser": "@babel/eslint-parser"
  },
  "dependencies": {
    "@citation-js/date": "^0.5.0",
    "@citation-js/name": "^0.4.2"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.0",
    "@babel/core": "^8.0.0",
    "@babel/eslint-parser": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/register": "^8.0.0",
    "babel-plugin-istanbul": "^8.0.0",
    "@citation-js/core": "^0.9.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "mocha": "^12.0.0",
    "nyc": "^18.0.0",
    "standard": "^17.0.0"
  },
  "peerDependencies": {
    "@citation-js/core": "^0.9.0"
  }
}
